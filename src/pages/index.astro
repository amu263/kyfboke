---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Splash from '../components/Splash.astro';
import SiteStats from '../components/SiteStats.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recent = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const links = [
  { label: '直播日记',  href: '/diary',     desc: '每一场直播之后的小记', icon: '📝' },
  { label: '时间线',    href: '/timeline',  desc: '从开播到现在都做了什么', icon: '⏳' },
  { label: '作品',      href: '/projects',  desc: '翻唱 / 剪辑 / 设计 / 杂项', icon: '🎨' },
  { label: '友链',      href: '/friends',   desc: '聊得来的朋友们', icon: '🔗' },
];
---
<BaseLayout fullBleed>
  <Splash />
  <Hero />

  <div class="stats-strip">
    <SiteStats />
  </div>

  <!-- 近期更新 — 参照 Mizuki PostCard 动效 -->
  <section class="section">
    <header class="section-head">
      <h2>近期更新</h2>
      <a href="/blog" class="section-more">
        查看全部
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </header>

    {recent.length === 0 ? (
      <p class="empty">还没有文章，稍等。</p>
    ) : (
      <ul class="post-list">
        {recent.map((post, i) => (
          <li class="post-card" style={`--stagger: ${i};`}>
            <a href={`/blog/${post.slug}/`}>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <span class="post-card-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- 传送门 — 参照 Mizuki Card 风格 -->
  <section class="section">
    <header class="section-head">
      <h2>传送门</h2>
      <p class="section-sub">站内的几个常去角落。</p>
    </header>
    <div class="link-grid">
      {links.map((l, i) => (
        <a class="link-card" href={l.href} style={`--stagger: ${i};`}>
          <span class="link-card-icon" aria-hidden="true">{l.icon}</span>
          <div>
            <h3>{l.label}</h3>
            <p>{l.desc}</p>
          </div>
          <span class="link-card-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .stats-strip {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--sp-2) var(--sp-3);
    display: flex;
    justify-content: center;
  }

  /* ═══ 页面容器 ═══ */
  .section {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
  }

  /* ═══ Section 头部 — Mizuki typography ═══ */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-4);
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .section-sub {
    color: var(--paper-dim);
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1;
  }
  .section-more {
    font-size: var(--fs-sm);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 250ms var(--ease-spring), transform 320ms var(--ease-spring);
  }
  .section-more:hover { gap: 8px; transform: translateX(2px); }
  .section-more .arrow { transition: transform 200ms ease; }
  .section-more:hover .arrow { transform: translateX(3px); }

  /* ═══ 空白态 ═══ */
  .empty {
    color: var(--paper-dim);
    padding: var(--sp-5) var(--sp-3);
    text-align: center;
    font-style: italic;
  }

  /* ═══ 文章卡片列表 — 参照 Mizuki PostCard ═══ */
  .post-list {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .post-card {
    opacity: 0;
    animation: card-in 500ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--stagger, 0) * 80ms + 200ms);
  }

  .post-card a {
    display: block;
    padding: var(--sp-4);
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-lg);
    position: relative;
    overflow: hidden;
    transition:
      transform 360ms var(--ease-spring),
      box-shadow 360ms var(--ease-spring),
      border-color 250ms ease;
  }

  .post-card a::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--accent-glow), transparent 60%);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .post-card a:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow:
      0 12px 40px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px var(--accent-glow);
  }
  .post-card a:hover::before { opacity: 0.04; }
  .post-card a:active { transform: translateY(-1px); }

  .post-card time {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--paper-dim);
    letter-spacing: 0.05em;
  }

  .post-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    margin: 8px 0 10px;
    color: var(--paper);
    line-height: 1.3;
    transition: color 200ms ease;
  }
  .post-card a:hover h3 { color: var(--accent-soft); }

  .post-card p {
    color: var(--paper-dim);
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-arrow {
    position: absolute;
    right: var(--sp-4); bottom: var(--sp-3);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 250ms ease,
      transform 320ms var(--ease-spring);
  }
  .post-card a:hover .post-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ═══ 传送门卡片 — 参照 Mizuki Card 风格 ═══ */
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-3);
  }

  .link-card {
    opacity: 0;
    animation: card-in 500ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--stagger, 0) * 80ms + 400ms);

    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-lg);
    color: var(--paper);
    position: relative;
    overflow: hidden;
    transition:
      transform 360ms var(--ease-spring),
      box-shadow 360ms var(--ease-spring),
      border-color 250ms ease;
  }

  .link-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--accent-glow), transparent 60%);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .link-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow:
      0 12px 40px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px var(--accent-glow);
  }
  .link-card:hover::before { opacity: 0.04; }
  .link-card:active { transform: translateY(-1px); }

  .link-card-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .link-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-md);
    margin: 0 0 4px;
    color: var(--paper);
    transition: color 200ms ease;
  }
  .link-card:hover h3 { color: var(--accent-soft); }

  .link-card p {
    color: var(--paper-dim);
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .link-card-arrow {
    position: absolute;
    right: var(--sp-4); bottom: var(--sp-3);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 250ms ease,
      transform 320ms var(--ease-spring);
  }
  .link-card:hover .link-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ═══ 动画 — 参照 Mizuki onload-animation ═══ */
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(2rem) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* 响应式 */
  @media (width < 768px) {
    .section { padding: var(--sp-4) var(--sp-3); }
    .section-head h2 { font-size: var(--fs-lg); }
    .link-grid { grid-template-columns: 1fr; }
    .post-card-arrow, .link-card-arrow { opacity: 0.5; transform: translateX(0); }
  }
</style>
