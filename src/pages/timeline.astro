---
import BaseLayout from '../layouts/BaseLayout.astro';
import timelineData from '../data/timeline.json';

const items = (timelineData.items || timelineData).sort((a: any, b: any) => b.date.localeCompare(a.date));
const intro = timelineData.intro || '把重要的节点记下来。';
---
<BaseLayout title="时间线" description="从开播到现在">
  <header class="head">
    <p class="eyebrow">从开始到现在</p>
    <h1>时间线</h1>
    <p class="lede">{intro}</p>
  </header>

  <ol class="timeline">
    {items.map(it => (
      <li>
        <span class="dot" aria-hidden="true"></span>
        <div class="row">
          <time datetime={it.date}>{it.date}</time>
          <h3>{it.label}</h3>
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .head { padding-bottom: var(--sp-3); border-bottom: 1px solid var(--ink-line); margin-bottom: var(--sp-4); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 var(--sp-1);
  }
  .head h1 { margin: 0 0 var(--sp-2); }
  .lede { color: var(--paper-dim); margin: 0; }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px; bottom: 8px;
    width: 1px;
    background: var(--ink-line);
  }
  .timeline li {
    position: relative;
    padding: var(--sp-2) 0 var(--sp-2) var(--sp-4);
  }
  .timeline .dot {
    position: absolute;
    left: 0; top: var(--sp-3);
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--ink-deep);
    border: 2px solid var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--sp-2);
    align-items: baseline;
  }
  .row time {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--paper-dim);
  }
  .row h3 {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--fs-md);
    color: var(--paper);
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>