---
import BaseLayout from '../layouts/BaseLayout.astro';
import friendsData from '../data/friends.json';

const friends = friendsData.items || friendsData;
const intro = friendsData.intro || '认识的人、聊得来的人。';
---
<BaseLayout title="友链" description="聊得来的朋友们">
  <header class="head">
    <p class="eyebrow">友情链接</p>
    <h1>友链</h1>
    <p class="lede">{intro}</p>
  </header>

  <p class="note">想交换友链的话,可以去 B 站私信我。</p>

  <ul class="list">
    {friends.map(f => (
      <li>
        <a href={f.url}>
          <h3>{f.name}</h3>
          <p>{f.desc}</p>
          <span class="go">访问 →</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .head { padding-bottom: var(--sp-3); border-bottom: 1px solid var(--ink-line); margin-bottom: var(--sp-3); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 var(--sp-1);
  }
  .head h1 { margin: 0 0 var(--sp-2); }
  .lede { color: var(--paper-dim); margin: 0; }
  .note { color: var(--paper-dim); font-size: var(--fs-sm); margin: 0 0 var(--sp-3); }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-2); }
  .list li a {
    display: block;
    padding: var(--sp-3);
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    color: var(--paper);
    border-bottom: 1px solid var(--ink-line);
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .list li a:hover {
    border-color: var(--accent);
    border-bottom-color: var(--accent);
    transform: translateY(-2px);
  }
  .list h3 { font-family: var(--font-text); margin: 0 0 4px; font-size: var(--fs-md); }
  .list p { color: var(--paper-dim); margin: 0 0 var(--sp-1); font-size: var(--fs-sm); }
  .go { color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-xs); }
</style>