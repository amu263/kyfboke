---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="文章" description="空予风的文章列表">
  <header class="head">
    <p class="eyebrow">所有文字</p>
    <h1>文章</h1>
    <p class="lede">写在这里的内容,通常是直播之后沉淀下来的想法、一些随笔、和偶尔的翻唱幕后。</p>
  </header>

  <ul class="list">
    {posts.length === 0 && <li class="empty">空空如也,稍后回来。</li>}
    {posts.map(post => (
      <li>
        <a href={`/blog/${post.slug}/`} class:list={['post-link', { 'has-cover': post.data.image }]}>
          {post.data.image && (
            <div class="post-cover">
              <img src={post.data.image} alt="" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="post-body">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
            {post.data.tags.length > 0 && (
              <ul class="tags">
                {post.data.tags.map(t => <li>#{t}</li>)}
              </ul>
            )}
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .head { padding-bottom: var(--sp-4); border-bottom: 1px solid var(--ink-line); margin-bottom: var(--sp-4); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0 0 var(--sp-1);
  }
  .head h1 { margin: 0 0 var(--sp-2); }
  .lede { color: var(--paper-dim); max-width: 60ch; margin: 0; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-2); }
  .post-link {
    display: flex;
    gap: var(--sp-3);
    padding: var(--sp-3);
    background: var(--ink-surface);
    border: 1px solid var(--ink-line);
    border-radius: var(--r-md);
    color: var(--paper);
    border-bottom: 1px solid var(--ink-line);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
    align-items: flex-start;
    text-decoration: none;
  }
  .post-link:hover {
    border-color: var(--accent);
    border-bottom-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }
  .post-cover {
    flex: 0 0 120px;
    width: 120px;
    aspect-ratio: 1;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--ink-elevated);
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-body { flex: 1; min-width: 0; }
  .list time {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--paper-dim);
  }
  .list h3 { font-family: var(--font-display); margin: 6px 0 8px; color: var(--paper); }
  .list p { color: var(--paper-dim); margin: 0 0 var(--sp-2); font-size: var(--fs-sm); }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--paper-dim);
    background: var(--ink-elevated);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .empty { color: var(--paper-dim); text-align: center; padding: var(--sp-4); }
</style>