---
/**
 * 页脚
 */
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <div class="col">
      <p class="brand">空予风 <span class="sub">— 一位虚拟主播的小角落</span></p>
      <p class="meta">
        生日 7月1日 · 哔哩哔哩 UID 1342014656
      </p>
    </div>
    <div class="col right">
      <p class="links">
        <a href="https://space.bilibili.com/1342014656" target="_blank" rel="noopener">B站</a>
        <span class="sep">·</span>
        <a href="/friends">友链</a>
        <span class="sep">·</span>
        <a href="/blog/rss.xml">RSS</a>
      </p>
      <p class="copy">© {year} 空予风</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ink-line);
    margin-top: var(--sp-6);
    padding: var(--sp-4) var(--sp-3);
    color: var(--paper-dim);
    font-size: var(--fs-sm);
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-text);
    font-size: var(--fs-md);
    color: var(--paper);
    margin: 0 0 4px;
  }
  .sub { color: var(--paper-dim); font-family: var(--font-text); font-weight: 400; font-size: var(--fs-sm); }
  .meta, .copy { margin: 0; font-size: var(--fs-xs); }
  .links { margin: 0 0 4px; }
  .links a { color: var(--paper); }
  .links a:hover { color: var(--accent); }
  .sep { margin: 0 6px; color: var(--ink-line); }
  .right { text-align: right; }
  @media (max-width: 720px) {
    .right { text-align: left; }
  }
</style>