---
/**
 * 相册瀑布流 — 直接抄 Mizuki 相册实现
 * 关键：全部图片一次性渲染，零 JS 追加，CSS columns 不重排
 */
interface Props {
  items: Array<{ src: string; width: number; height: number; name: string }>;
}
const { items } = Astro.props;
const totalCount = items.length;
---
<section class="gallery">
  <div class="gallery-masonry" id="gallery-masonry">
    {items.map(item => (
      <div class="gallery-photo-card" data-full={item.src}>
        <img
          src={item.src}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    ))}
  </div>

  <p class="gallery-end">
    共 {totalCount} 张
  </p>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lightbox-close" aria-label="关闭">&times;</button>
  <img class="lightbox-img" id="lightbox-img" alt="" />
</div>

<script>
  const grid = document.getElementById('gallery-masonry');
  if (grid) {
    const lb = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbClose = document.getElementById('lightbox-close')!;

    function open(s: string) { lbImg.src = s; lb.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function close() { lb.classList.remove('open'); lbImg.src = ''; document.body.style.overflow = ''; }

    grid.addEventListener('click', e => {
      const item = (e.target as HTMLElement).closest('.gallery-photo-card') as HTMLElement | null;
      if (item?.dataset.full) open(item.dataset.full);
    });
    lbClose.addEventListener('click', close);
    lb.addEventListener('click', e => { if (e.target === lb) close(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && lb.classList.contains('open')) close(); });
  }
</script>

<style>
  .gallery { width: 100%; max-width: 100vw; margin: 0 auto; padding: var(--sp-2) 0; overflow: hidden; }

  /* ═══ 瀑布流 — 抄 Mizuki albums.css ═══ */
  .gallery-masonry {
    column-width: 240px;
    column-gap: 0.75rem;
  }

  .gallery-photo-card {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: 0.75rem;
    cursor: pointer;
  }

  .gallery-photo-card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 360ms var(--ease-spring);
  }

  .gallery-photo-card:hover img {
    transform: scale(1.05);
  }

  /* 响应式列宽 — 抄 Mizuki */
  @media (width < 768px) {
    .gallery-masonry { column-width: 180px; }
  }
  @media (width < 480px) {
    .gallery-masonry { column-width: 140px; }
  }

  /* ═══ Lightbox ═══ */
  .lightbox { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(15,26,46,.92); align-items: center; justify-content: center; padding: var(--sp-4); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .lightbox.open { display: flex; }
  .lightbox-img { max-width: 92vw; max-height: 92vh; object-fit: contain; border-radius: var(--r-sm); box-shadow: 0 0 80px -20px rgba(0,174,236,.25); animation: lb-in 280ms ease; }
  @keyframes lb-in { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: scale(1); } }
  .lightbox-close { position: absolute; top: var(--sp-3); right: var(--sp-3); width: 44px; height: 44px; border: none; background: var(--ink-elevated); color: var(--paper); font-size: 1.6rem; line-height: 1; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 160ms, color 160ms; }
  .lightbox-close:hover { background: var(--accent); color: var(--ink-deep); }

  /* ═══ 页脚 ═══ */
  .gallery-end { margin: var(--sp-5) 0; text-align: center; color: var(--paper-dim); font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: .2em; }

  @media (prefers-reduced-motion: reduce) {
    .gallery-photo-card img, .lightbox-img { animation: none; transition: none; }
  }
</style>
